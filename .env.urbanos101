# Non-secret settings for the deployed functions. Keys belong in Secret Manager.
#
# This file must exist and hold at least one value. Without any dotenv values at
# deploy time, the Firebase CLI keeps whatever variables the function already has,
# so a key once deployed as a plain variable keeps colliding with the secret of
# the same name and every deploy fails.
LLM_PROVIDER=gemini,llama_cpp
TRIAGE_BACKEND=queue
TRIAGE_RULES_FIRST=1
# Keep Functions Framework request threads aligned with the API instance limit.
THREADS=32
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
