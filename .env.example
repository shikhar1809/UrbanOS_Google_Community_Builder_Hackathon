TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
GEMINI_API_KEY=your_gemini_api_key_here
FIREBASE_API_KEY=your_firebase_web_api_key_here
ADMIN_EMAILS=mp-office@example.com,aide@example.com

# --- Operations -------------------------------------------------------------
# Admin allowlist. Required: with this unset nobody can sign in to the dashboard.
ADMIN_EMAILS=mp-office@example.com,aide@example.com

# Where triage runs. "inline" (default) classifies inside the webhook request.
# "background" files the report, answers the citizen, then classifies after the
# response, which is what keeps WhatsApp deliveries from timing out under load.
TRIAGE_BACKEND=inline

# Ceiling on reports held in memory by the analytics snapshot.
SNAPSHOT_MAX_RECORDS=5000

# Set to false only to debug a webhook URL mismatch. Leaving it off lets anyone
# forge citizen reports.
TWILIO_VALIDATE_SIGNATURE=true

# --- Models -----------------------------------------------------------------
# Which backend answers. "auto" (default) takes the first that is reachable, in
# the order ollama, groq, gemini, so a model running locally is preferred over
# billed quota. Name one explicitly to pin it; a pinned provider that is not
# reachable does NOT fall back, so the choice is never silently overridden.
LLM_PROVIDER=auto

# Local open-source models via Ollama. Triage is schema-constrained
# classification and narration is prose, so they may warrant different models;
# OLLAMA_TRIAGE_MODEL defaults to OLLAMA_CHAT_MODEL when unset.
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_TRIAGE_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=180

# Hosted fallbacks. Narration works with either; structured triage needs Gemini.
# GEMINI_API_KEY is declared above.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound
GEMINI_CHAT_MODEL=gemini-2.5-flash
